# ============================================================
# MemForge environment template
# Copy to `.env` and fill in your values. `.env` is gitignored;
# never commit real API keys.
# ============================================================

# --- LLM (OpenAI-compatible; used by Stage 5B real QA) ---
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Qwen/DashScope,
# Moonshot, vLLM, Ollama, LM Studio, ...
MEMFORGE_LLM_MODEL=deepseek-chat
MEMFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
MEMFORGE_LLM_API_KEY=sk-REPLACE_ME

# --- Embedding / Hugging Face cache ---
# Model weights are cached locally; set a path inside the repo so it stays
# reproducible and is covered by .gitignore (.hf_cache/).
HF_HOME=./.hf_cache
# If huggingface.co is unreachable from your network, use the mirror:
HF_ENDPOINT=https://hf-mirror.com

# --- Database (Stage 1 storage layer; not needed for retrieval/QA benchmarks) ---
# Matches docker-compose.yml (postgres:55432, user/pass/db = memforge)
MEMFORGE_DATABASE_URL=postgresql+asyncpg://memforge:memforge@localhost:55432/memforge
